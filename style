
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;600;700;800&display=swap');

:root {
  --green: #236b4b;
  --light-green: #e9f4ec;
  --ink: #19251f;
  --muted: #69766e;
  --border: #e4e9e4;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #fbfcfa;
  color: var(--ink);
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 6%;
  background: white;
  border-bottom: 1px solid var(--border);
}

.logo {
  font-family: 'Manrope', sans-serif;
  font-weight: 800;
  font-size: 20px;
  color: var(--ink);
  text-decoration: none;
}

.logo span {
  color: #849187;
  font-weight: 500;
}

.privacy {
  background: var(--light-green);
  color: var(--green);
  padding: 9px 12px;
  border-radius: 25px;
  font-size: 11px;
}

.container {
  max-width: 1180px;
  margin: auto;
  padding: 40px 24px 24px;
}

.hero {
  text-align: center;
  margin-bottom: 35px;
}

.eyebrow {
  color: var(--green);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
}

h1 {
  font-family: 'Manrope', sans-serif;
  font-size: clamp(34px, 5vw, 54px);
  line-height: 1.15;
  letter-spacing: -2px;
  margin: 18px 0;
}

h1 span {
  color: var(--green);
}

.subtitle {
  max-width: 600px;
  margin: auto;
  color: var(--muted);
  line-height: 1.8;
}

.features {
  margin-top: 18px;
  font-size: 11px;
  color: var(--green);
}

.workspace {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  align-items: stretch;
}

.panel {
  background: white;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 8px 25px #243d2b08;
  min-width: 0;
}

h2 {
  font-family: 'Manrope', sans-serif;
  font-size: 16px;
  margin: 0 0 24px;
}

label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  margin: 16px 0 7px;
}

input,
select,
textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid #dfe6df;
  border-radius: 8px;
  background: white;
  font: inherit;
  font-size: 12px;
  color: var(--ink);
  outline: none;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #6b9b7b;
  box-shadow: 0 0 0 3px var(--light-green);
}

textarea {
  resize: vertical;
  line-height: 1.6;
}

.two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

#generateBtn {
  width: 100%;
  margin-top: 22px;
  padding: 14px;
  background: var(--green);
  color: white;
  border: none;
  border-radius: 9px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s;
}

#generateBtn:hover {
  background: #19553a;
  transform: translateY(-1px);
}

#generateBtn:disabled {
  opacity: 0.65;
  cursor: wait;
}

.hint {
  text-align: center;
  font-size: 10px;
  line-height: 1.6;
  color: #89948b;
}

.output-heading,
.result-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.output-heading h2 {
  margin-bottom: 24px;
}

#status {
  color: var(--green);
  background: var(--light-green);
  padding: 7px;
  border-radius: 6px;
  font-size: 9px;
  margin-bottom: 24px;
}

.empty-state {
  min-height: 400px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.illustration {
  display: grid;
  place-items: center;
  background: var(--light-green);
  color: var(--green);
  width: 95px;
  height: 95px;
  border-radius: 25px;
  font-size: 30px;
  margin-bottom: 20px;
}

.empty-state h3 {
  font-family: 'Manrope', sans-serif;
  font-size: 17px;
}

.empty-state p {
  max-width: 270px;
  color: var(--muted);
  line-height: 1.7;
  font-size: 12px;
}

.chips,
.tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 7px;
  margin-top: 15px;
}

.chips span,
.tag {
  font-size: 10px;
  padding: 7px 9px;
  border-radius: 6px;
  background: var(--light-green);
  color: var(--green);
}

.result-block {
  border-bottom: 1px solid #edf0ec;
  padding-bottom: 15px;
  margin-bottom: 15px;
}

.result-heading h3 {
  font-size: 12px;
  margin: 0 0 10px;
}

.result-block p {
  color: #59665d;
  font-size: 12px;
  line-height: 1.8;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.copy-btn,
.secondary-btn {
  padding: 7px 10px;
  border: 1px solid var(--border);
  background: white;
  color: var(--green);
  border-radius: 6px;
  font-size: 10px;
  cursor: pointer;
}

.copy-btn:hover,
.secondary-btn:hover {
  background: var(--light-green);
}

.tags {
  justify-content: flex-start;
}

.secondary-btn {
  width: 100%;
  padding: 12px;
  font-weight: 700;
}

.hidden {
  display: none !important;
}

.benefits {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  padding: 25px;
  margin: 32px 0;
  background: white;
  border: 1px solid var(--border);
  border-radius: 15px;
}

.benefits h3 {
  font-size: 12px;
  font-family: 'Manrope', sans-serif;
}

.benefits p {
  font-size: 11px;
  line-height: 1.8;
  color: var(--muted);
}

footer {
  border-top: 1px solid var(--border);
  padding-top: 18px;
  display: flex;
  justify-content: space-between;
  gap: 12px;
  font-size: 10px;
  color: var(--muted);
}

footer strong {
  color: var(--green);
}

#toast {
  position: fixed;
  left: 50%;
  bottom: 22px;
  transform: translateX(-50%);
  background: #1c3024;
  color: white;
  padding: 12px 18px;
  border-radius: 8px;
  opacity: 0;
  pointer-events: none;
  transition: 0.2s;
  font-size: 12px;
  z-index: 10;
  max-width: 90%;
}

#toast.show {
  opacity: 1;
}

@media (max-width: 800px) {
  .workspace {
    grid-template-columns: 1fr;
  }

  .empty-state {
    min-height: 300px;
  }

  .benefits {
    gap: 12px;
  }
}

@media (max-width: 540px) {
  .navbar {
    padding: 17px;
  }

  .logo {
    font-size: 16px;
  }

  .container {
    padding: 28px 14px;
  }

  .panel {
    padding: 18px;
  }

  .two-col,
  .benefits {
    grid-template-columns: 1fr;
  }

  h1 {
    letter-spacing: -1px;
  }

  footer {
    flex-direction: column;
  }
}
